{
  "name": "scriptdesk-desktop",
  "productName": "ScriptDesk",
  "version": "1.12.0",
  "description": "ScriptDesk \u2013 AI film script breakdown (desktop app for Windows and Mac)",
  "author": "Bhargav Madasu",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.cpSync('../www','www',{recursive:true})\"",
    "start": "npm run prepare-web && electron .",
    "dist": "npm run prepare-web && electron-builder --publish never",
    "dist:win": "npm run prepare-web && electron-builder --win --publish never",
    "dist:mac": "npm run prepare-web && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.scriptdesk.app",
    "productName": "ScriptDesk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "ScriptDesk-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "ScriptDesk-${version}-mac.dmg"
    }
  }
}